{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "apps/**",
      "packages/**",
      "models/**",
      "rules/slop_terms.json",
      "ml/personas/**",
      "!!vendor",
      "!**/dist/**",
      "!**/target/**",
      "!**/node_modules/**",
      "!packages/lexel-browser/public/**",
      "!packages/lexel-browser/src/contentScript/googleDocsBootstrap.js"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true
  }
}
