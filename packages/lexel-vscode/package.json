{
  "name": "lexel-vscode",
  "displayName": "Lexel Local Writing Assistant",
  "description": "100% local grammar, anti-slop, secrets guard, .lexel.toml repo rules, and diff-grounded commit/PR polish for VS Code, Cursor, and Windsurf powered by lexel-ls.",
  "version": "0.1.0",
  "publisher": "lexel-ai",
  "license": "Apache-2.0",
  "icon": "icon.png",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:markdown",
    "onLanguage:plaintext",
    "onLanguage:git-commit",
    "onLanguage:rust",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:python",
    "onLanguage:go",
    "onLanguage:c",
    "onLanguage:cpp",
    "onLanguage:java",
    "onLanguage:html",
    "onLanguage:latex",
    "onLanguage:typst",
    "onLanguage:asciidoc",
    "onLanguage:org"
  ],
  "contributes": {
    "commands": [
      {
        "command": "lexel.restartServer",
        "title": "Lexel: Restart Language Server"
      },
      {
        "command": "lexel.fixAllSafe",
        "title": "Lexel: Fix All Safe Issues (No AI)"
      },
      {
        "command": "lexel.deslopDocument",
        "title": "Lexel: Deslop Document (Local AI)"
      },
      {
        "command": "lexel.fixGrammarFlow",
        "title": "Lexel: Fix Grammar & Flow (Local AI)"
      },
      {
        "command": "lexel.shortenDocument",
        "title": "Lexel: Shorten Document (Local AI)"
      },
      {
        "command": "lexel.polishCommit",
        "title": "Lexel: Polish Commit Message with Staged Diff (Local AI)"
      },
      {
        "command": "lexel.polishPr",
        "title": "Lexel: Polish PR Description with Branch Diff (Local AI)"
      },
      {
        "command": "lexel.runDoctor",
        "title": "Lexel: Run Doctor Diagnostics"
      },
      {
        "command": "lexel.initRepoConfig",
        "title": "Lexel: Create .lexel.toml Repo Config"
      },
      {
        "command": "lexel.checkWorkspaceCi",
        "title": "Lexel: Check Current File (CI Mode)"
      },
      {
        "command": "lexel.importGitVoice",
        "title": "Lexel: Clone My Voice from Git Log"
      }
    ],
    "configuration": {
      "title": "Lexel",
      "properties": {
        "lexel.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable live Lexel grammar, anti-slop, secrets guard, .lexel.toml, and style guide linting."
        },
        "lexel.path": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to the lexel-ls binary. Defaults to lexel-ls on PATH."
        },
        "lexel.cliPath": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to the lexel CLI binary used by doctor, CI check, and voice import commands. Defaults to lexel on PATH."
        },
        "lexel.diffGrounding": {
          "type": "string",
          "enum": [
            "auto",
            "staged",
            "branch",
            "off"
          ],
          "default": "auto",
          "description": "Feed Git diff stats into local AI commit and PR rewrites so suggestions reference real changed files."
        },
        "lexel.baseBranch": {
          "type": "string",
          "default": "",
          "description": "Optional base branch (for example main) used for branch diff grounding on PR descriptions. Auto-detects origin/HEAD, main, or master when blank."
        },
        "lexel.useRepoConfig": {
          "type": "boolean",
          "default": true,
          "description": "Automatically discover and apply .lexel.toml repository configuration when linting and rewriting files."
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
