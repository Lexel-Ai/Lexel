{
  "name": "lexel-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev:browser": "pnpm --filter lexel-browser dev",
    "dev:desktop": "pnpm --filter lexel-desktop dev",
    "build:browser": "pnpm --filter lexel-ui build && pnpm --filter lexel-browser build",
    "build:desktop": "pnpm --filter lexel-ui build && pnpm --filter lexel-desktop build",
    "tauri:dev": "pnpm --filter lexel-desktop tauri dev",
    "tauri:build": "pnpm --filter lexel-desktop tauri build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build"
  }
}
